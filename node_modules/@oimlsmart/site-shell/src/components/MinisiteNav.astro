---
/**
 * The component-local nav (TODO.FULL/02) — a minisite declares its own
 * sections; the strip renders under the federation header.
 */
interface Section { label: string; href: string }
interface Props {
  sections: Section[]
  base?: string
}
const { sections, base = '' } = Astro.props
const path = Astro.url.pathname
---

<nav aria-label="Sections" class="border-b border-rule bg-paper dark:bg-paper-deep">
  <div class="max-w-7xl mx-auto px-6 flex items-center gap-6 h-11">
    {sections.map(s => (
      <a
        href={`${base}${s.href}`}
        class={`text-sm font-medium transition-colors whitespace-nowrap ${path === `${base}${s.href}` || path === `${base}${s.href}/` ? 'text-accent font-semibold' : 'text-ink-soft hover:text-accent'}`}
      >{s.label}</a>
    ))}
    {Astro.slots.has('default') && (
      <div class="ml-auto flex items-center gap-2"><slot /></div>
    )}
  </div>
</nav>
