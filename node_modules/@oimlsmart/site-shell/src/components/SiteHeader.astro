---
/**
 * The federation header — brand + the injected nav + search + theme +
 * identity. Every piece of content arrives by prop: `brand` draws the
 * brand block and the default sign-in link, `nav` drives the desktop
 * menu and the mobile overlay (and carries the origin relative hrefs
 * resolve against). An absent prop omits its block; the header itself
 * renders whatever it is given — Base decides not to mount it at all
 * when the consumer injected neither brand nor nav.
 */
import MobileNav from './MobileNav.vue'
import NavDropdown from './NavDropdown.vue'
import SearchBox from './SearchBox.vue'
import ThemeToggle from './ThemeToggle.vue'
import AiBubble from './AiBubble.vue'
import { isLinkActive, resolveNavHref, terseItems, type BrandConfig, type NavModel, type ServicesRegistry } from '../config'

interface Props {
  /** The identity bundle — absent, no brand block and no sign-in link. */
  brand?: BrandConfig
  /** The nav model — absent, no menu and no mobile overlay mount. */
  nav?: NavModel
  /** The service origins; the AI assistant reads `services.ai`. */
  services?: ServicesRegistry
  /** Whether the consumer mounted real signin-slot content (an account
   *  chip) — Base threads this so the mobile overlay can drop its
   *  logged-out "Sign in" link. */
  hasSignin?: boolean
  /** The AI assistant bubble (TODO.ai-platform/01) — OFF unless the
   *  consuming property opts in. `true` mounts it against the injected
   *  services registry's `ai` origin; the object form overrides the
   *  origin (staging) and the answer-language hint. `contextChips`
   *  (TODO.ai-platform/02) opts the property into the opt-in context
   *  chips + the honest context line; `accountChip` (TODO.ai-platform/03)
   *  adds the member-only "my account" chip (the live-data delegation);
   *  `draftActs` (TODO.ai-platform/04) renders the draft cards for
   *  AI-prepared acts and hands them to the host's real form. */
  aiAssistant?: boolean | { apiBase?: string; lang?: string; contextChips?: boolean; accountChip?: boolean; draftActs?: boolean }
}
const { brand, nav, services, hasSignin = false } = Astro.props
const path = Astro.url.pathname
const ai = Astro.props.aiAssistant
const aiConfig = ai && typeof ai === 'object' ? ai : {}
let aiBase: string | undefined
if (ai) {
  aiBase = aiConfig.apiBase ?? services?.ai
  if (!aiBase) {
    throw new Error('site-shell: aiAssistant is enabled but no AI service origin is configured — pass services={ ai } or aiAssistant={{ apiBase }}')
  }
}
const origin = nav?.origin
const signInHref = brand?.signInHref
// The menus' terse view of the nav: links arrive without `desc`, so a
// dropdown cannot render a description it was never handed.
const menuItems = nav ? terseItems(nav.items) : []
---

<header class="site-nav sticky top-0 z-[100] bg-paper-soft dark:bg-paper-deep border-b border-rule">
  <div class="max-w-7xl mx-auto px-6 flex items-center justify-between gap-4 h-14">
    {brand && (
      <a href={brand.homeHref} class="nav-brand flex items-center gap-2 no-underline text-ink min-w-0">
        <img src={brand.logoLight} alt="" class="logo-light h-7 w-auto shrink-0" />
        <img src={brand.logoDark} alt="" class="logo-dark h-7 w-auto shrink-0" />
        <span class="font-serif text-base font-semibold tracking-tight truncate">{brand.brandName}</span>
      </a>
    )}
    <div class="flex items-center gap-2 sm:gap-4 min-w-0">
      {nav ? (
        <nav class="nav-menu hidden lg:flex items-center gap-3" id="nav-menu" aria-label="Primary">
          {menuItems.map(item => (
            item.type === 'dropdown' ? (
              <NavDropdown client:load config={item.config} currentPath={path} origin={origin} />
            ) : (
              <a
                href={resolveNavHref(item.href, undefined, origin)}
                class={`text-sm font-medium text-ink-soft hover:text-accent transition-colors whitespace-nowrap ${isLinkActive(item.matchPrefix, path) ? 'text-accent font-semibold' : ''}`}
              >{item.label}</a>
            )
          ))}
          {nav.productCta && (
            <a
              href={resolveNavHref(nav.productCta.href, nav.productCta.external, origin)}
              class="text-sm font-semibold text-paper bg-accent hover:bg-accent-deep transition-colors rounded px-2.5 py-1 whitespace-nowrap"
              data-testid="nav-product-cta"
            >{nav.productCta.label}</a>
          )}
          <SearchBox client:idle />
          <ThemeToggle client:load />
          {ai && <AiBubble client:load mode="chrome" apiBase={aiBase} lang={aiConfig.lang} contextChips={aiConfig.contextChips} accountChip={aiConfig.accountChip} draftActs={aiConfig.draftActs} />}
        </nav>
      ) : (
        <div class="hidden lg:flex items-center gap-3">
          <ThemeToggle client:load />
          {ai && <AiBubble client:load mode="chrome" apiBase={aiBase} lang={aiConfig.lang} contextChips={aiConfig.contextChips} accountChip={aiConfig.accountChip} draftActs={aiConfig.draftActs} />}
        </div>
      )}
      <!-- Identity, not navigation: the account chip (or the brand's
           sign-in link) stays visible at EVERY breakpoint — it never
           collapses with the nav. Keep chips compact and shrink-0. A
           mounted chip REPLACES the default link (hasSignin threading);
           with no signInHref the brand has no sign-in and neither
           renders. -->
      <div class="flex items-center shrink-0">
        {hasSignin ? <slot name="signin" /> : (signInHref && <a href={signInHref} class="shell-signin text-sm font-semibold text-accent whitespace-nowrap shrink-0">Sign in ↗</a>)}
      </div>
    </div>
    {nav && (
      <MobileNav
        client:load
        items={menuItems}
        productCta={nav.productCta}
        origin={origin}
        brandName={brand?.brandName}
        logoLight={brand?.logoLight}
        logoDark={brand?.logoDark}
        homeHref={brand?.homeHref}
        signInHref={signInHref}
        show-sign-in={!hasSignin && !!signInHref}
      />
    )}
  </div>
</header>
