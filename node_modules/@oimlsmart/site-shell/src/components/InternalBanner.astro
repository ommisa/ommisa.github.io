---
/**
 * The internal-draft banner — the top site's marking that its documents
 * are drafts. The copy is the shell's; the programme link is injected
 * (Base resolves a relative href against the nav model's origin). With
 * no href the banner renders without a link.
 */
interface Props {
  href?: string
  message?: string
}
const { href, message = 'OIML SMART pilot programme · internal use only · all documents and specifications are drafts and may change without notice' } = Astro.props
const Link = href ? 'a' : 'div'
---

<Link
  href={href}
  aria-label={href ? 'Learn about the OIML SMART pilot programme' : undefined}
  class="block no-underline text-inherit hover:opacity-80 transition-opacity"
>
  <div class="bg-[repeating-linear-gradient(45deg,#fffbeb,#fffbeb_10px,#fef3c7_10px,#fef3c7_20px)] dark:bg-[repeating-linear-gradient(45deg,#1f2937,#1f2937_10px,#111827_10px,#111827_20px)] border-b border-[#d97706] py-2.5 px-4 text-xs leading-[1.4] text-[#78350f] dark:text-[#fde68a] text-center">
    <div class="max-w-7xl mx-auto flex items-center gap-2 justify-center">
      <span class="shrink-0 bg-[#d97706] text-white font-mono text-[0.6875rem] font-semibold tracking-[0.08em] px-2 py-0.5 rounded-sm">DRAFT</span>
      <span class="shrink-0 text-sm">⚠</span>
      <span>{message}</span>
    </div>
  </div>
</Link>
