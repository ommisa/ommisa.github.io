---
import ComponentLogo from './ComponentLogo.astro'

interface Props {
  title?: string
  lede?: string
  description?: string
  align?: 'left' | 'center'
  /** The minisite hero mark: the component's logo slug, its one-sentence
   *  alt, and the asset base the slug resolves against (injected — the
   *  package ships no asset origin). */
  logo?: { name: string; alt: string; base: string }
}

const { title, lede, description, align = 'left', logo } = Astro.props
const displayLede = lede ?? description
const alignClass = align === 'center' ? 'text-center mx-auto items-center' : ''
---

{title && (
  <section class={`page-hero relative pt-14 pb-10 mb-10 border-b border-rule bp-grid bp-grid--major ${alignClass}`}>
    <div class="page-hero__inner relative z-10">
      {logo && (
        <ComponentLogo name={logo.name} alt={logo.alt} base={logo.base} width={120} class="block mb-6" />
      )}
      <h1 class="page-hero__title font-serif text-[clamp(2rem,5vw,3.25rem)] font-medium tracking-[-0.025em] leading-[1.05] max-w-3xl text-balance">
        {title}
      </h1>
      {displayLede && (
        <p class="page-hero__lede text-[1.125rem] leading-[1.6] text-ink-soft max-w-2xl mt-5">
          {displayLede}
        </p>
      )}
    </div>
  </section>
)}

<style>
  .page-hero {
    position: relative;
  }
  .page-hero__inner {
    /* Match the .prose-enhanced container below the hero so titles and body
       text share the same column. Keeps the layout coherent across every
       ContentPage (news, pages, etc.). */
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .page-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(to right, var(--accent), transparent 70%);
    opacity: 0.6;
  }
</style>
