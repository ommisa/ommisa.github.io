---
/**
 * The federation footer — the shared frame (brand block, the Explore
 * column derived from the injected nav, the consumer's own columns,
 * The sites column, attribution, legal, copyright). Every piece of
 * content arrives by prop; an absent prop omits its block, and Base
 * mounts no footer at all when the consumer injects no `footer`.
 * Links resolve against the footer config's origin, falling back to
 * the nav model's (front-door absolute from a minisite — ADR-0003).
 */
import { resolveNavHref, type BrandConfig, type NavModel, type FooterConfig, type FooterLink } from '../config'

interface Props {
  brand?: BrandConfig
  nav?: NavModel
  footer?: FooterConfig
}
const { brand, nav, footer } = Astro.props
const origin = footer?.origin ?? nav?.origin
const hrefOf = (link: FooterLink) => resolveNavHref(link.href, link.external, origin)

// The Explore column derives from the injected nav — each dropdown
// lands on its first link, each standalone link on itself.
const explore = (nav?.items ?? [])
  .map(item => item.type === 'dropdown'
    ? { label: item.config.label, link: item.config.links[0] }
    : { label: item.label, link: { label: item.label, href: item.href } })
  .filter(e => !!e.link)
const bottomBar = !!(footer?.attribution?.length || footer?.legal?.length || footer?.copyright)
---

<footer class="border-t border-rule bg-paper-deep">
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- Brand + description -->
      {brand && (
        <div>
          <div class="flex items-center gap-2 mb-3">
            <img src={brand.logoLight} alt="" class="logo-light h-6 w-auto" />
            <img src={brand.logoDark} alt="" class="logo-dark h-6 w-auto" />
            <span class="font-serif text-sm font-semibold">{brand.brandName}</span>
          </div>
          {footer?.description && (
            <p class="text-xs text-ink-muted leading-relaxed max-w-xs">{footer.description}</p>
          )}
        </div>
      )}

      <!-- Quick links — derived from the injected nav -->
      {explore.length > 0 && (
        <div>
          <h3 class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-3">Explore</h3>
          <ul class="space-y-2">
            {explore.map(e => (
              <li>
                <a
                  href={hrefOf(e.link)}
                  class="text-sm text-ink-soft hover:text-accent transition-colors"
                >{e.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- The consumer's own columns -->
      {footer?.columns?.map(column => (
        <div>
          <h3 class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-3">{column.heading}</h3>
          <ul class="space-y-2">
            {column.links.map(link => (
              <li>
                <a
                  href={hrefOf(link)}
                  class="inline-flex items-center gap-2 text-sm text-ink-soft hover:text-accent transition-colors"
                >
                  {link.icon === 'github' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="shrink-0">
                      <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                    </svg>
                  )}
                  <span>{link.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- The sites — the injected host list -->
      {footer?.hosts && footer.hosts.length > 0 && (
        <div>
          <h3 class="text-xs font-mono uppercase tracking-wider text-ink-muted mb-3">The sites</h3>
          <ul class="space-y-2">
            {footer.hosts.map(host => (
              <li>
                <a href={hrefOf(host)} class="text-sm text-ink-soft hover:text-accent transition-colors">{host.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    {bottomBar && (
      <div class="pt-6 border-t border-rule-soft flex flex-col sm:flex-row items-center justify-between gap-3">
        {footer?.attribution && footer.attribution.length > 0 && (
          <p class="text-xs text-ink-muted text-center sm:text-left">
            {footer.attribution.map(segment => typeof segment === 'string'
              ? <span>{segment}</span>
              : <a href={hrefOf(segment)} class="text-accent hover:underline">{segment.label}</a>
            )}
          </p>
        )}
        {footer?.legal && footer.legal.length > 0 && (
          <nav aria-label="Legal" class="flex items-center gap-4 text-xs">
            {footer.legal.map(link => (
              <a href={hrefOf(link)} class="text-ink-soft hover:text-accent transition-colors">{link.label}</a>
            ))}
          </nav>
        )}
        {footer?.copyright && (
          <p class="text-xs text-ink-muted whitespace-nowrap">{footer.copyright}</p>
        )}
      </div>
    )}
  </div>
</footer>
