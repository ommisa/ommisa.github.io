---
/**
 * TierToggle — segmented control that swaps visibility of page blocks
 * between the SMART and SMART+ tiers. Pages mark blocks with
 * `data-tier="smart"` or `data-tier="smartplus"`; this component
 * shows the matching set and hides the other.
 *
 * The initial tier reads from the URL hash (`#smart`, `#smartplus`) so a
 * shared link lands on the right tier; otherwise SMART (the broader
 * scope) is the default. Selecting a tier updates the hash without
 * scrolling, so visitors can switch without losing their place.
 */
interface Props {
  /** Which tier to show on first paint when the URL hash is unset. */
  default?: 'smart' | 'smartplus'
  /** Optional eyebrow label above the toggle. */
  label?: string
}
const { default: defaultTier = 'smart', label = 'Scope tier' } = Astro.props
---

<div class="tier-toggle" data-tier-toggle data-default={defaultTier}>
  <span class="tier-toggle__label">{label}</span>
  <div class="tier-toggle__segmented" role="tablist" aria-label={label}>
    <a
      href="#smart"
      class="tier-toggle__option"
      role="tab"
      aria-selected="false"
      data-tier-option="smart"
    >
      <span class="tier-toggle__pill">SMART</span>
      <span class="tier-toggle__hint">Type-approval</span>
    </a>
    <a
      href="#smartplus"
      class="tier-toggle__option"
      role="tab"
      aria-selected="false"
      data-tier-option="smartplus"
    >
      <span class="tier-toggle__pill">SMART+</span>
      <span class="tier-toggle__hint">Instance + measurement</span>
    </a>
  </div>
</div>

<style>
  .tier-toggle {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    background: var(--paper-soft, #f5f3ed);
    border: 1px solid var(--rule, #d8d3c8);
    border-radius: 6px;
    margin-bottom: 2rem;
  }
  .tier-toggle__label {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted, #6b6358);
  }
  .tier-toggle__segmented {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--paper-deep, #ebe7df);
    border-radius: 4px;
  }
  .tier-toggle__option {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.375rem 0.875rem;
    border-radius: 3px;
    text-decoration: none;
    color: var(--ink-soft, #4a4540);
    transition: background 150ms ease, color 150ms ease;
    min-width: 8rem;
  }
  .tier-toggle__option:hover {
    color: var(--ink, #1a1a1a);
  }
  .tier-toggle__option[aria-selected='true'] {
    background: var(--paper, #faf8f3);
    color: var(--accent, #004996);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .tier-toggle__pill {
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.01em;
  }
  .tier-toggle__hint {
    font-family: var(--font-mono, monospace);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted, #6b6358);
    opacity: 0.85;
  }
  .tier-toggle__option[aria-selected='true'] .tier-toggle__hint {
    color: var(--accent, #004996);
    opacity: 0.75;
  }

  :global([data-tier='smart']),
  :global([data-tier='smartplus']) {
    /* Default: SMART visible, SMART+ hidden. The inline script flips this
       on load if the URL hash is #smartplus. The attribute selector below
       is intentionally global so any block on the page can opt in. */
  }
  :global([data-tier='smartplus']) {
    display: none;
  }
  :global(body[data-active-tier='smartplus']) [data-tier='smart'] {
    display: none;
  }
  :global(body[data-active-tier='smartplus']) [data-tier='smartplus'] {
    display: revert;
  }
  /* When the toggle itself is hidden inside an inactive tier block,
     don't leave a gap. */
  :global([data-tier='smartplus'].tier-toggle),
  :global([data-tier='smart'].tier-toggle) {
    display: block;
  }
</style>

<script is:inline>
  (function () {
    const valid = new Set(['smart', 'smartplus'])
    function currentTier(defaultTier) {
      const hash = window.location.hash.replace(/^#/, '')
      return valid.has(hash) ? hash : defaultTier
    }
    function applyTier(tier) {
      document.body.setAttribute('data-active-tier', tier)
      document.querySelectorAll('[data-tier-option]').forEach((opt) => {
        opt.setAttribute('aria-selected', opt.getAttribute('data-tier-option') === tier ? 'true' : 'false')
      })
    }
    document.addEventListener('astro:page-load', function () {
      const toggle = document.querySelector('[data-tier-toggle]')
      if (!toggle) {
        document.body.removeAttribute('data-active-tier')
        return
      }
      const defaultTier = toggle.getAttribute('data-default') || 'smart'
      applyTier(currentTier(defaultTier))
    })
    window.addEventListener('hashchange', function () {
      const toggle = document.querySelector('[data-tier-toggle]')
      if (!toggle) return
      const defaultTier = toggle.getAttribute('data-default') || 'smart'
      applyTier(currentTier(defaultTier))
    })
    document.addEventListener('click', function (e) {
      const target = e.target instanceof Element ? target = e.target.closest('[data-tier-option]') : null
      if (!target) return
      const tier = target.getAttribute('data-tier-option')
      if (!valid.has(tier)) return
      e.preventDefault()
      const desired = '#' + tier
      if (window.location.hash !== desired) {
        window.location.hash = desired
      } else {
        applyTier(tier)
      }
    })
  })()
</script>
