---
/**
 * The house base layout — html shell + fonts + tokens + the injected
 * chrome. The consumer passes its own site config:
 *   <Base title="…" brand={BRAND} nav={NAV} services={SERVICES} footer={FOOTER} />
 * The package carries no site content: with no `brand` and no `nav` it
 * renders no header, and with no `footer` it renders no footer — the
 * page keeps its skip link, main landmark, and theme bootstrap either
 * way. Tokens come from @oimlsmart/site-shell/tokens.css (the one home
 * for colors and type); the theme runtime owns dark mode.
 */
import { ClientRouter } from 'astro:transitions'
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import InternalBanner from './InternalBanner.astro'
import { resolveNavHref, type BrandConfig, type NavModel, type ServicesRegistry, type FooterConfig } from '../config'
import { THEME_BOOTSTRAP } from '../composables/useTheme'

interface Props {
  title: string
  description?: string
  /** The site name in the <title>; defaults to the injected brand's name. */
  siteTitle?: string
  /** The identity bundle — absent, no header renders at all. */
  brand?: BrandConfig
  /** The nav model — absent, the header renders no menu and no mobile
   *  overlay mounts. */
  nav?: NavModel
  /** The service origins; the AI assistant reads `services.ai` when its
   *  flag carries no explicit apiBase. */
  services?: ServicesRegistry
  /** The footer content — absent, no footer renders. */
  footer?: FooterConfig
  /** The internal-draft banner — `true` for the default marking, or an
   *  object to override the copy and set the programme link (relative
   *  hrefs resolve against the nav model's origin). */
  internal?: boolean | { href?: string; message?: string }
  /** The html lang attribute — bilingual minisites pass their page locale. */
  lang?: string
  /** The AI assistant bubble (TODO.ai-platform/01) — off by default; the
   *  consuming property opts in (`true`, which reads `services.ai`) or
   *  overrides the service origin (`{ apiBase }`) for staging.
   *  `contextChips` (TODO.ai-platform/02) opts into the opt-in context
   *  chips + the honest context line; `accountChip` (TODO.ai-platform/03)
   *  adds the member-only "my account" chip (the live-data delegation);
   *  `draftActs` (TODO.ai-platform/04) renders the draft cards for
   *  AI-prepared acts and hands them to the host's real form through the
   *  DOM seam. */
  aiAssistant?: boolean | { apiBase?: string; lang?: string; contextChips?: boolean; accountChip?: boolean; draftActs?: boolean }
}
const { title, description, siteTitle, internal = false, lang = 'en-US', aiAssistant = false } = Astro.props
const { brand, nav, services, footer } = Astro.props
const resolvedSiteTitle = siteTitle ?? brand?.brandName
const pageTitle = resolvedSiteTitle ? (title ? `${title} | ${resolvedSiteTitle}` : resolvedSiteTitle) : title
const banner = internal === true ? {} : internal || {}
const providesSignin = Astro.slots.has('signin')

const FONT_URL =
  'https://fonts.googleapis.com/css2?' +
  'family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600;9..144,700' +
  '&family=IBM+Plex+Sans:wght@300;400;500;600;700' +
  '&family=IBM+Plex+Mono:wght@400;500;600' +
  '&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700' +
  '&display=swap'
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <ClientRouter />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={FONT_URL} />
  {brand?.themeColor && <meta name="theme-color" content={brand.themeColor} />}
  <meta name="color-scheme" content="light dark" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  <slot name="head" />
</head>
<body>
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[400] focus:top-3 focus:left-3 focus:px-4 focus:py-2 focus:rounded focus:bg-paper focus:text-ink focus:border focus:border-rule focus:shadow no-underline">Skip to content</a>
  {internal && <InternalBanner href={banner.href ? resolveNavHref(banner.href, banner.external, nav?.origin) : undefined} message={banner.message} />}
  {(brand || nav) && (
    <SiteHeader
      brand={brand}
      nav={nav}
      services={services}
      hasSignin={providesSignin}
      aiAssistant={aiAssistant}
    >
      <!-- Forwarded only when the consumer mounted real slot content (an
           account chip); SiteHeader renders the brand's own sign-in link
           otherwise. -->
      {providesSignin && <slot name="signin" slot="signin" />}
    </SiteHeader>
  )}
  <main id="main" class="min-h-[calc(100vh-3.5rem-5rem)]">
    <slot />
  </main>
  {footer && <SiteFooter brand={brand} nav={nav} footer={footer} />}

  <script is:inline set:html={THEME_BOOTSTRAP} />
</body>
</html>
