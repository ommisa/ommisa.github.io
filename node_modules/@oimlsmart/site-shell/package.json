{
  "name": "@oimlsmart/site-shell",
  "version": "0.2.0",
  "description": "The OIML SMART house shell — the chrome machinery every OIML SMART site mounts (federation header and footer frames, nav rendering, minisite nav, hero, docs layout, theme runtime, design tokens, the AI assistant island). The package ships machinery only: every site injects its own nav model, brand, services, and footer content.",
  "repository": {
    "type": "git",
    "url": "https://github.com/oimlsmart/site-shell"
  },
  "type": "module",
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "gate:render": "npm --prefix test/fixture run check:render",
    "check:nav": "node scripts/check-nav.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./chrome/astro": "./src/index.ts",
    "./chrome/astro/*": "./src/components/*",
    "./config": "./src/config/index.ts",
    "./brand": "./src/config/brand.ts",
    "./theme": "./src/composables/useTheme.ts",
    "./ai": "./src/ai/client.ts",
    "./ai/context": "./src/ai/context.ts",
    "./ai/drafts": "./src/ai/drafts.ts",
    "./ai/client": "./src/ai/client.ts",
    "./ai/markdown": "./src/ai/markdown.ts",
    "./ai/*": "./src/ai/*",
    "./tokens.css": "./src/styles/tokens.css",
    "./blueprint.css": "./src/styles/blueprint.css",
    "./data/chrome.mjs": "./src/data/chrome.mjs",
    "./data/theme.mjs": "./src/data/theme.mjs"
  },
  "files": [
    "src",
    "scripts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "astro": ">=5",
    "vue": ">=3.5"
  }
}
