---
interface Props { title: string; lede?: string }
const { title, lede } = Astro.props
---
<section class="border-b border-(--rule) py-12 md:py-16">
  <h1 class="display text-4xl md:text-5xl leading-tight m-0">{title}</h1>
  {lede && <p class="mt-5 max-w-2xl text-lg text-(--ink-soft) leading-relaxed">{lede}</p>}
  <slot />
</section>
